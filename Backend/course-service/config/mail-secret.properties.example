# Copiez ce fichier vers mail-secret.properties (même dossier config/).
# mail-secret.properties est ignoré par Git — ne le commitez pas.
#
# L’adresse ci-dessous doit être exactement le compte Gmail où vous avez créé le mot de passe d’application.
spring.mail.username=VOTRE_ADRESSE_GMAIL@gmail.com
# Remplacez par les 16 caractères du mot de passe d’application Google, sans espaces.
spring.mail.password=VOTRE_MOT_DE_PASSE_APPLICATION_16_CARACTERES
